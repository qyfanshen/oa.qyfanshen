# MySQL（宝塔与网站在同一服务器时保持 127.0.0.1）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fanshen_oa_app
DB_PASSWORD=replace-with-your-database-password
DB_NAME=fanshen_oa

# 用随机的 32 字符以上字符串替换。不要提交 .env.local 到代码仓库。
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_ENFORCE=true

# 首次初始化管理员账号时使用，仅运行 init:auth 脚本需要。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
TEST_EMPLOYEE_USERNAME=test_employee
TEST_EMPLOYEE_PASSWORD=Employee@2026
