# ========== 数据库配置（宝塔面板创建的数据库） ==========
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fanshen_oa
DB_USER=fanshen_oa_app
# 替换为宝塔面板创建数据库时设置的真实密码
DB_PASSWORD=replace-with-your-database-password

# ========== 应用配置 ==========
APP_ENV=production
APP_DEBUG=false
APP_URL=https://oa.qyfanshen.com

# ========== 登录会话密钥（必填，至少 32 位随机字符串） ==========
# 修改此值会导致所有已登录用户被踢回登录页重新登录
# 生成方法：openssl rand -hex 32  或  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
# 启用登录校验（默认强制鉴权，设为 false 才会关闭）
AUTH_ENFORCE=true

# ========== 管理员账号初始化（仅 npm run init:auth 时使用） ==========
ADMIN_USERNAME=fanshen_superadmin
# 至少 12 位，包含字母数字符号
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# 测试账号（可选，不设置则不创建；生产环境建议留空）
# TEST_EMPLOYEE_USERNAME=test_employee
# TEST_EMPLOYEE_PASSWORD=replace-with-strong-password

# ========== 微信小程序登录（小程序对接必填） ==========
# 在微信公众平台「开发管理 → 开发设置」获取 AppID 和 AppSecret
# WECHAT_APPID=wxe8b6be22312cfa03
# WECHAT_SECRET=replace-with-your-wechat-appsecret

# ========== 考勤打卡位置校验（可选） ==========
# 配置公司位置经纬度后，开启"必须在公司附近打卡"校验（默认 500 米）
# 不配置则跳过位置校验（任何位置都可打卡）
# 公司经纬度获取：地图搜索公司地址后复制坐标
# OFFICE_LAT=39.908823
# OFFICE_LNG=116.397470
# OFFICE_RADIUS_M=500

# ========== AI 配置（DeepSeek） ==========
# 在 https://platform.deepseek.com 申请 API Key
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
# 可选：自定义 API 地址（默认 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选：自定义模型（默认 deepseek-chat）
# DEEPSEEK_MODEL=deepseek-chat
# 演示模式：设为 true 时不调真实 LLM，返回模拟数据
# AI_DEMO_MODE=false
